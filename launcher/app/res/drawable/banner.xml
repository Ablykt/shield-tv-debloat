<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 TV banner: soft dusk gradient with a single white disc -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF1B2A3A" android:endColor="#FF4A6B5D" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="56dp" android:height="56dp">
        <shape android:shape="oval">
            <solid android:color="#F2FFFFFF" />
        </shape>
    </item>
</layer-list>
